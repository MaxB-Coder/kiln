{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/London",
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "vulnerabilityAlerts": { "enabled": true, "labels": ["security"], "schedule": ["at any time"] },
  "packageRules": [
    {
      "description": "The terminal engine: security fixes arrive as plain version bumps.",
      "matchPackageNames": ["alacritty_terminal"],
      "labels": ["engine"]
    },
    {
      "description": "GPUI follows Zed main weekly. When it bumps, re-sync [patch.crates-io] with zed/Cargo.toml.",
      "matchDepNames": ["zed-industries/zed"],
      "groupName": "gpui",
      "labels": ["gpui"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "GPUI git pins in Cargo.toml",
      "managerFilePatterns": ["/^Cargo\\.toml$/"],
      "matchStrings": [
        "git = \"https://github.com/zed-industries/zed\", rev = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "zed-industries/zed",
      "packageNameTemplate": "https://github.com/zed-industries/zed",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ]
}
